    "check": "biome check .",
    "check:fix": "biome check . --fix --unsafe"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
