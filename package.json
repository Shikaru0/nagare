{
  "name": "nagare",
  "module": "src/index.ts",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"bun run src/index.ts\" \"bunx vite\"",
    "build": "bunx vite build",
